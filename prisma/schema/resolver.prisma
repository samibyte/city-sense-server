model ResolverProfile {
  id String @id @default(uuid())

  bio             String?
  resume          String?
  resumePublicId  String?
  additionalFiles Json? // Array of file URLs or file metadata // Stores: [{ url: "...", publicId: "..." }]

  verificationStatus ResolverVerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  // Relations from Assignment model
  assignments Assignment[] @relation("AssignmentResolver")
  feedbacks   Feedback[]   @relation("FeedbackResolver")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("resolvers")
}
