NODE_ENV="development"
PORT=5000
DATABASE_URL="db_url"
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:5000"
BCRYPT_SALT_ROUNDS=10
ACCESS_TOKEN_SECRET=accesstokensec....
REFRESH_TOKEN_SECRET=refreshtockensec....
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d
# SMTP (Gmail). SMTP_PASS must be a Gmail App Password (16-char), NOT the
# account password. Requires 2FA enabled. SMTP_SECURE=true => implicit TLS (port 465).
EMAIL_SENDER_SMTP_USER=samibyte.web@gmail.com
EMAIL_SENDER_SMTP_PASS=your_gmail_app_password
EMAIL_SENDER_SMTP_HOST=smtp.gmail.com
EMAIL_SENDER_SMTP_PORT=587
EMAIL_SENDER_SMTP_FROM=samibyte.web@gmail.com
EMAIL_SENDER_SMTP_SECURE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=stripesec...
STRIPE_WEBHOOK_SECRET=stripwebhooksec..
REDIS_USER=default
REDIS_PASSWORD=redispass
REDIS_HOST=redis_host
REDIS_PORT=redis_port